pipeline {
    agent any

    environment {
        DB_NAME = 'test_db'  // Correspond à spring.datasource.url
        DB_USER = 'root'
        DB_PASS = ''  // Pas de mot de passe défini dans application-test.properties
        DB_PORT = '3306'  // Port par défaut, car localhost:3306 est utilisé
        MYSQL_CONTAINER = 'mysql-test'
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    git branch: 'ouday', url: 'https://github.com/LaameriSayf/DevopsSkiStation.git'
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    sh 'mvn clean compile'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SQ1') {
                    sh 'mvn sonar:sonar'
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    sh 'mvn test'
                }
            }
        }
    }
}
