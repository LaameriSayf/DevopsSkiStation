pipeline {
    agent any

    environment {
        DB_NAME = 'stationski'
        DB_USER = 'root'
        DB_PASS = ''
        DB_PORT = '3306'
        MYSQL_CONTAINER = 'mysql-test'
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    try {
                        echo "🔄 Starting Checkout Stage..."
                        git branch: 'Halim', url: 'https://github.com/LaameriSayf/DevopsSkiStation.git'
                    } finally {
                        def endTime = System.currentTimeMillis()
                        echo "✅ Checkout Complete in ${(endTime - startTime) / 1000}s"
                    }
                }
            }
        }

        stage('Test Docker') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    try {
                        echo "🔍 Verifying Docker Setup..."
                        sh '''
                        whoami
                        docker version
                        docker ps
                        '''
                    } finally {
                        def endTime = System.currentTimeMillis()
                        echo "✅ Docker Test Completed in ${(endTime - startTime) / 1000}s"
                    }
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    try {
                        echo "🔨 Starting Build Process..."
                        sh 'mvn clean compile'
                    } finally {
                        def endTime = System.currentTimeMillis()
                        echo "✅ Build Complete in ${(endTime - startTime) / 1000}s"
                    }
                }
            }
        }

        stage('Test with Coverage') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    try {
                        echo "🧪 Running Tests with Coverage..."
                        sh 'mvn test'
                    } finally {
                        def endTime = System.currentTimeMillis()
                        echo "✅ Test with Coverage Completed in ${(endTime - startTime)}ms"
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    try {
                        echo "🔍 Running SonarQube Analysis..."
                        withSonarQubeEnv('SonarQube') {
                            sh 'mvn sonar:sonar'
                        }
                    } finally {
                        def endTime = System.currentTimeMillis()
                        echo "✅ SonarQube Analysis Completed in ${(endTime - startTime) / 1000}s"
                    }
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    try {
                        echo "🚀 Deploying to Nexus..."
                        sh 'mvn deploy -DskipTests'
                    } finally {
                        def endTime = System.currentTimeMillis()
                        echo "✅ Deployment to Nexus Complete in ${(endTime - startTime) / 1000}s"
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                echo '🐳 Building Docker Image...'
                script {
                    def startTime = System.currentTimeMillis()
                    try {
                        sh 'docker build -t halimtrabelsi/gestionstationski-app:0.0.1 .'
                    } finally {
                        def endTime = System.currentTimeMillis()
                        echo "✅ Docker Build Complete in ${(endTime - startTime) / 1000}s"
                    }
                }
            }
        }

        stage('List Docker Images') {
            steps {
                echo '📦 Listing Docker Images...'
                sh 'docker images'
            }
        }

        stage('Push to DockerHub') {
            steps {
                script {
                    echo '🚀 Pushing Docker Image to DockerHub...'
                    withCredentials([usernamePassword(credentialsId: 'dockerhub', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PAT')]) {
                        def startTime = System.currentTimeMillis()
                        try {
                            sh '''
                            echo "$DOCKER_PAT" | docker login -u "$DOCKER_USER" --password-stdin
                            docker push halimtrabelsi/gestionstationski-app:0.0.1
                            docker logout
                            '''
                        } finally {
                            def endTime = System.currentTimeMillis()
                            echo "✅ Docker Image Pushed to DockerHub in ${(endTime - startTime) / 1000}s"
                        }
                    }
                }
            }
        }

        stage('Trivy Scan - DockerHub Image') {
            steps {
                script {
                    def imageName = "halimtrabelsi/gestionstationski-app:0.0.1"
                    echo "🔍 Scanning Docker Hub image with Trivy: ${imageName}"
                    sh """
                        trivy image --severity CRITICAL --exit-code 0 --no-progress ${imageName} > trivy-report.txt || true
                    """
                    sh 'cat trivy-report.txt'
                }
            }
        }

        stage('Deploy with Docker Compose') {
            steps {
                echo '🚀 Deploying with Docker Compose...'
                sh 'docker compose up -d'
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'trivy-report.txt', onlyIfSuccessful: false
        }
        success {
            emailext (
                subject: "✅ Pipeline Success - Build #${BUILD_NUMBER}",
                body: """
                    <h2>Pipeline Report - Build #${BUILD_NUMBER} - Success</h2>
                    <p>Status: Success 🎉</p>
                    <p><strong>Project:</strong> DevopsSkiStation</p>
                    <p><strong>Branch:</strong> origin/Halim</p>
                    <p><strong>Duration:</strong> ${currentBuild.durationString}</p>
                    <p><strong>Docker Image:</strong> halimtrabelsi/gestionstationski-app:0.0.1</p>
                    <p><strong>Logs:</strong> <a href='${env.BUILD_URL}'>View full logs</a></p>
                    <h3>Stage Summary</h3>
                    <table border="1" style="border-collapse: collapse;">
                        <tr><th>Stage</th><th>Duration (s)</th></tr>
                        <tr><td>Checkout</td><td>${currentBuild.getBuildVariables().checkoutDuration}</td></tr>
                        <tr><td>Test Docker</td><td>${currentBuild.getBuildVariables().dockerTestDuration}</td></tr>
                        <!-- Add more stages here with dynamic duration -->
                    </table>
                """,
                mimeType: 'text/html',
                to: 'halimtrabelsi73@gmail.com'
            )
        }
        failure {
            emailext (
                subject: "❌ Pipeline Failed - Build #${BUILD_NUMBER}",
                body: """
                    <h2>Pipeline Report - Build #${BUILD_NUMBER} - Failed</h2>
                    <p>Status: Failure 🚨</p>
                    <p><strong>Project:</strong> DevopsSkiStation</p>
                    <p><strong>Branch:</strong> origin/Halim</p>
                    <p><strong>Duration:</strong> ${currentBuild.durationString}</p>
                    <p><strong>Logs:</strong> <a href='${env.BUILD_URL}'>View full logs</a></p>
                    <h3>Stage Summary</h3>
                    <table border="1" style="border-collapse: collapse;">
                        <tr><th>Stage</th><th>Duration (s)</th></tr>
                        <tr><td>Checkout</td><td>${currentBuild.getBuildVariables().checkoutDuration}</td></tr>
                        <tr><td>Test Docker</td><td>${currentBuild.getBuildVariables().dockerTestDuration}</td></tr>
                        <!-- Add more stages here with dynamic duration -->
                    </table>
                """,
                mimeType: 'text/html',
                to: 'halimtrabelsi73@gmail.com'
            )
        }
    }
}
