pipeline {
    agent any

    environment {
        DB_NAME = 'test_db'
        DB_USER = 'root'
        DB_PASS = credentials('mysql-password')
        DB_PORT = '3306'
        MYSQL_CONTAINER = 'mysql-test'
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials')
        IMAGE_NAME = 'ouday2025/devopsskistation'
        IMAGE_TAG = "v${env.BUILD_NUMBER}"
    }

    stages {
        stage('Initialize') {
            steps {
                script {
                    def pipelineReport = [:]
                    pipelineReport['stages'] = [:]
                    pipelineReport['testResults'] = [:]
                    pipelineReport['trivyResults'] = ''
                    pipelineReport['sonarUrl'] = ''
                    pipelineReport['dockerComposeStatus'] = ''
                    writeJSON file: 'pipelineReport.json', json: pipelineReport
                    env.pipelineReportFile = 'pipelineReport.json'
                }
            }
        }

        stage('Checkout') {
            steps {
                script {
                    def pipelineReport = readJSON file: env.pipelineReportFile
                    def startTime = System.currentTimeMillis()
                    try {
                        git branch: 'ouday', url: 'https://github.com/LaameriSayf/DevopsSkiStation.git'
                    } finally {
                        def duration = (System.currentTimeMillis() - startTime) / 1000
                        pipelineReport['stages']['Checkout'] = duration
                        writeJSON file: env.pipelineReportFile, json: pipelineReport
                        echo "Durée de l'étape Checkout : ${duration}s"
                    }
                }
            }
        }

        stage('Test Docker') {
            steps {
                script {
                    def pipelineReport = readJSON file: env.pipelineReportFile
                    def startTime = System.currentTimeMillis()
                    try {
                        sh '''
                        set -e
                        echo "Vérification de Docker..."
                        whoami
                        docker version
                        docker ps
                        '''
                    } finally {
                        def duration = (System.currentTimeMillis() - startTime) / 1000
                        pipelineReport['stages']['Test Docker'] = duration
                        writeJSON file: env.pipelineReportFile, json: pipelineReport
                        echo "Durée de l'étape Test Docker : ${duration}s"
                    }
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    def pipelineReport = readJSON file: env.pipelineReportFile
                    def startTime = System.currentTimeMillis()
                    try {
                        sh '''
                        set -e
                        mvn clean compile
                        '''
                    } finally {
                        def duration = (System.currentTimeMillis() - startTime) / 1000
                        pipelineReport['stages']['Build'] = duration
                        writeJSON file: env.pipelineReportFile, json: pipelineReport
                        echo "Durée de l'étape Build : ${duration}s"
                    }
                }
            }
        }

        stage('Test with Coverage') {
            steps {
                script {
                    def pipelineReport = readJSON file: env.pipelineReportFile
                    def startTime = System.currentTimeMillis()
                    try {
                        sh '''
                        set -e
                        echo "Exécution des tests avec couverture..."
                        mvn test
                        '''
                        def surefireReport = sh(script: "cat target/surefire-reports/*.txt | grep 'Tests run:' || true", returnStdout: true).trim()
                        if (surefireReport) {
                            pipelineReport['testResults']['summary'] = surefireReport
                        } else {
                            pipelineReport['testResults']['summary'] = 'No test results found'
                        }
                    } finally {
                        def duration = (System.currentTimeMillis() - startTime) / 1000
                        pipelineReport['stages']['Test with Coverage'] = duration
                        writeJSON file: env.pipelineReportFile, json: pipelineReport
                        echo "Durée de l'étape Test with Coverage : ${duration}s"
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def pipelineReport = readJSON file: env.pipelineReportFile
                    def startTime = System.currentTimeMillis()
                    try {
                        withSonarQubeEnv('SQ1') {
                            sh '''
                            set -e
                            mvn sonar:sonar
                            '''
                        }
                        pipelineReport['sonarUrl'] = 'http://192.168.33.10:9000/dashboard?id=tn.esprit%3Aouday_oueslati'
                    } finally {
                        def duration = (System.currentTimeMillis() - startTime) / 1000
                        pipelineReport['stages']['SonarQube Analysis'] = duration
                        writeJSON file: env.pipelineReportFile, json: pipelineReport
                        echo "Durée de l'étape SonarQube Analysis : ${duration}s"
                    }
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                script {
                    def pipelineReport = readJSON file: env.pipelineReportFile
                    def startTime = System.currentTimeMillis()
                    try {
                        sh '''
                        set -e
                        echo "Déploiement vers Nexus (tests ignorés)..."
                        mvn deploy -DskipTests
                        '''
                    } finally {
                        def duration = (System.currentTimeMillis() - startTime) / 1000
                        pipelineReport['stages']['Deploy to Nexus'] = duration
                        writeJSON file: env.pipelineReportFile, json: pipelineReport
                        echo "Durée de l'étape Deploy to Nexus : ${duration}s"
                    }
                }
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                script {
                    def pipelineReport = readJSON file: env.pipelineReportFile
                    def startTime = System.currentTimeMillis()
                    try {
                        sh '''
                        set -e
                        echo "Vérification de la présence du Dockerfile..."
                        if [ -f Dockerfile ]; then
                            echo "Dockerfile trouvé."
                            cat Dockerfile
                        else
                            echo "Erreur : Dockerfile introuvable !"
                            exit 1
                        fi
                        echo "Connexion à Docker Hub..."
                        echo $DOCKERHUB_CREDENTIALS_PSW | docker login -u $DOCKERHUB_CREDENTIALS_USR --password-stdin
                        echo "Construction de l'image Docker ${IMAGE_NAME}:${IMAGE_TAG}..."
                        docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                        echo "Vérification de l'image construite..."
                        docker images | grep ${IMAGE_NAME}
                        echo "Pousse de l'image ${IMAGE_NAME}:${IMAGE_TAG} vers Docker Hub..."
                        docker push ${IMAGE_NAME}:${IMAGE_TAG}
                        '''
                    } finally {
                        def duration = (System.currentTimeMillis() - startTime) / 1000
                        pipelineReport['stages']['Build and Push Docker Image'] = duration
                        writeJSON file: env.pipelineReportFile, json: pipelineReport
                        echo "Durée de l'étape Build and Push Docker Image : ${duration}s"
                    }
                }
            }
        }

        stage('Scan Docker Image') {
            steps {
                script {
                    def pipelineReport = readJSON file: env.pipelineReportFile
                    def startTime = System.currentTimeMillis()
                    try {
                        sh '''
                        set -e
                        echo "Vérification de la présence de l'image ${IMAGE_NAME}:${IMAGE_TAG}..."
                        if docker images | grep -q "${IMAGE_NAME}.*${IMAGE_TAG}"; then
                            echo "Image ${IMAGE_NAME}:${IMAGE_TAG} trouvée localement."
                        else
                            echo "Erreur : Image ${IMAGE_NAME}:${IMAGE_TAG} introuvable localement !"
                            exit 1
                        fi
                        echo "Scan de l'image avec Trivy..."
                        trivy image --exit-code 0 --severity HIGH,CRITICAL --scanners vuln --timeout 20m ${IMAGE_NAME}:${IMAGE_TAG} > trivy_output.txt 2>&1
                        trivy_output=$(cat trivy_output.txt | grep 'Total:' || echo "No vulnerabilities found")
                        echo "$trivy_output"
                        '''
                        pipelineReport['trivyResults'] = sh(script: 'cat trivy_output.txt | grep "Total:" || echo "No vulnerabilities found"', returnStdout: true).trim()
                    } finally {
                        def duration = (System.currentTimeMillis() - startTime) / 1000
                        pipelineReport['stages']['Scan Docker Image'] = duration
                        writeJSON file: env.pipelineReportFile, json: pipelineReport
                        echo "Durée de l'étape Scan Docker Image : ${duration}s"
                    }
                }
            }
        }

        stage('Docker Compose') {
            steps {
                script {
                    def pipelineReport = readJSON file: env.pipelineReportFile
                    def startTime = System.currentTimeMillis()
                    try {
                        sh '''
                        set -e
                        echo "Vérification de la présence de docker-compose.yml..."
                        if [ -f docker-compose.yml ]; then
                            echo "Fichier docker-compose.yml trouvé."
                            cat docker-compose.yml
                        else
                            echo "Erreur : docker-compose.yml introuvable !"
                            exit 1
                        fi
                        echo "Vérification de l'image Docker..."
                        docker images | grep ${IMAGE_NAME}
                        echo "Vérification et arrêt du conteneur mysql-test..."
                        if docker ps -a --format '{{.Names}}' | grep -q "^$MYSQL_CONTAINER$"; then
                            echo "Arrêt et suppression du conteneur mysql-test..."
                            docker stop $MYSQL_CONTAINER || true
                            docker rm $MYSQL_CONTAINER || true
                        fi
                        echo "Vérification des ports utilisés..."
                        docker ps -a --format '{{.Names}} {{.Ports}}'
                        echo "Exportation de IMAGE_TAG et DB_PASS pour Docker Compose..."
                        export IMAGE_TAG=${IMAGE_TAG}
                        export DB_PASS="$DB_PASS"
                        echo "Vérification des valeurs exportées..."
                        echo "IMAGE_TAG=${IMAGE_TAG}"
                        echo "DB_PASS=${DB_PASS}"
                        echo "Validation de docker-compose.yml..."
                        docker-compose config || { echo "Erreur : échec de la validation Docker Compose" >&2; exit 1; }
                        echo "Lancement de Docker Compose avec IMAGE_TAG=${IMAGE_TAG}..."
                        docker-compose up -d
                        echo "Attente que les services soient prêts (max 120 sec)..."
                        for i in $(seq 1 40); do
                            if docker-compose ps app | grep -q "Up (healthy)" && docker-compose ps mysql | grep -q "Up (healthy)"; then
                                echo "Les services app et mysql sont prêts !"
                                break
                            fi
                            echo "Services pas encore prêts, attente 3 secondes... (tentative $i/40)"
                            docker-compose logs app | tail -n 10
                            docker-compose logs mysql | tail -n 10
                            sleep 3
                        done
                        if [ $i -eq 40 ]; then
                            echo "Échec : les services ne sont pas prêts après 40 tentatives !"
                            docker-compose logs app
                            docker-compose logs mysql
                            exit 1
                        fi
                        echo "Vérification des conteneurs lancés..."
                        docker-compose ps
                        '''
                        pipelineReport['dockerComposeStatus'] = sh(script: '''
                        docker-compose ps --services | while read service; do
                            status=$(docker-compose ps $service | awk 'NR>2 {print $6, $7}' | tr -d '\n')
                            echo "$service $status"
                        done
                        ''', returnStdout: true).trim()
                    } finally {
                        def duration = (System.currentTimeMillis() - startTime) / 1000
                        pipelineReport['stages']['Docker Compose'] = duration
                        writeJSON file: env.pipelineReportFile, json: pipelineReport
                        echo "Durée de l'étape Docker Compose : ${duration}s"
                    }
                }
            }
        }

        stage('Check Spring Boot Logs') {
            steps {
                script {
                    def pipelineReport = readJSON file: env.pipelineReportFile
                    def startTime = System.currentTimeMillis()
                    try {
                        sh '''
                        set -e
                        echo "Vérification des logs du conteneur sonar-app-1..."
                        docker logs sonar-app-1
                        '''
                    } finally {
                        def duration = (System.currentTimeMillis() - startTime) / 1000
                        pipelineReport['stages']['Check Spring Boot Logs'] = duration
                        writeJSON file: env.pipelineReportFile, json: pipelineReport
                        echo "Durée de l'étape Check Spring Boot Logs : ${duration}s"
                    }
                }
            }
        }

        stage('Verify Spring Boot Prometheus Endpoint') {
            steps {
                script {
                    def pipelineReport = readJSON file: env.pipelineReportFile
                    def startTime = System.currentTimeMillis()
                    try {
                        sh '''
                        set -e
                        echo "Vérification de l'endpoint Prometheus de Spring Boot..."
                        for i in $(seq 1 10); do
                            echo "Tentative $i/10..."
                            if curl -s -o /dev/null -w "%{http_code}" http://localhost:8090/actuator/prometheus | grep -q "200"; then
                                echo "L'endpoint Prometheus de Spring Boot est accessible (code HTTP : 200)"
                                exit 0
                            fi
                            echo "L'endpoint n'est pas encore prêt, nouvelle tentative dans 10 secondes..."
                            sleep 10
                        done
                        echo "Échec : l'endpoint Prometheus de Spring Boot n'est pas accessible après 10 tentatives !"
                        exit 1
                        '''
                    } finally {
                        def duration = (System.currentTimeMillis() - startTime) / 1000
                        pipelineReport['stages']['Verify Spring Boot Prometheus Endpoint'] = duration
                        writeJSON file: env.pipelineReportFile, json: pipelineReport
                        echo "Durée de l'étape Verify Spring Boot Prometheus Endpoint : ${duration}s"
                    }
                }
            }
        }

        stage('Restart Prometheus') {
            steps {
                script {
                    def pipelineReport = readJSON file: env.pipelineReportFile
                    def startTime = System.currentTimeMillis()
                    try {
                        sh '''
                        set -e
                        echo "Redémarrage de Prometheus pour scraper les nouvelles métriques..."
                        docker exec -it prometheus kill -HUP 1
                        echo "Attente de 20 secondes pour que Prometheus scrape les métriques..."
                        sleep 20
                        '''
                    } finally {
                        def duration = (System.currentTimeMillis() - startTime) / 1000
                        pipelineReport['stages']['Restart Prometheus'] = duration
                        writeJSON file: env.pipelineReportFile, json: pipelineReport
                        echo "Durée de l'étape Restart Prometheus : ${duration}s"
                    }
                }
            }
        }

        stage('Verify Prometheus Status') {
            steps {
                script {
                    def pipelineReport = readJSON file: env.pipelineReportFile
                    def startTime = System.currentTimeMillis()
                    try {
                        sh '''
                        set -e
                        echo "Vérification de l'état de l'endpoint spring-boot dans Prometheus..."
                        status=$(curl -s "http://localhost:9090/api/v1/query?query=up{job=\\"spring-boot\\"}" | jq -r '.data.result[0].value[1]')
                        if [ "$status" = "1" ]; then
                            echo "L'endpoint spring-boot est UP dans Prometheus."
                        else
                            echo "Erreur : l'endpoint spring-boot est DOWN dans Prometheus (valeur : $status) !"
                            exit 1
                        fi
                        '''
                    } finally {
                        def duration = (System.currentTimeMillis() - startTime) / 1000
                        pipelineReport['stages']['Verify Prometheus Status'] = duration
                        writeJSON file: env.pipelineReportFile, json: pipelineReport
                        echo "Durée de l'étape Verify Prometheus Status : ${duration}s"
                    }
                }
            }
        }

        stage('Deploy to Kubernetes with Helm') {
            steps {
                script {
                    def pipelineReport = readJSON file: env.pipelineReportFile
                    def startTime = System.currentTimeMillis()
                    try {
                        sh '''
                        set -e
                        echo "Vérification des outils Kubernetes..."
                        kubectl version --client
                        helm version
                        echo "Contenu du répertoire de travail pour débogage :"
                        ls -la
                        echo "Vérification de la présence du chart Helm..."
                        if [ -d "helm" ]; then
                            echo "Répertoire helm trouvé."
                            ls -l helm
                        else
                            echo "Erreur : Répertoire helm introuvable !"
                            echo "Vérifiez que le répertoire helm est inclus dans la branche ouday du dépôt Git."
                            exit 1
                        fi
                        echo "Déploiement avec Helm..."
                        helm upgrade --install devopsskistation helm \
                            --namespace default \
                            --set image.tag=${IMAGE_TAG} \
                            --set mysql.secretName=mysql-credentials \
                            --set mysql.database=${DB_NAME}
                        echo "Vérification du déploiement..."
                        kubectl get pods -n default
                        kubectl get svc -n default
                        '''
                    } finally {
                        def duration = (System.currentTimeMillis() - startTime) / 1000
                        pipelineReport['stages']['Deploy to Kubernetes with Helm'] = duration
                        writeJSON file: env.pipelineReportFile, json: pipelineReport
                        echo "Durée de l'étape Deploy to Kubernetes with Helm : ${duration}s"
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                def pipelineReport = [:]
                if (fileExists(env.pipelineReportFile ?: 'pipelineReport.json')) {
                    pipelineReport = readJSON file: env.pipelineReportFile
                } else {
                    echo "No pipelineReport found, initializing empty report"
                    pipelineReport['stages'] = [:]
                    pipelineReport['testResults'] = [:]
                    pipelineReport['trivyResults'] = 'Not executed'
                    pipelineReport['sonarUrl'] = 'Not executed'
                    pipelineReport['dockerComposeStatus'] = 'Not executed'
                }
                def emailBody = """
                <html>
                <body style='font-family: Arial, sans-serif; color: #333;'>
                    <h2>Pipeline Report - Build #${env.BUILD_NUMBER}</h2>
                    <p><strong>Status:</strong> ${currentBuild.result == 'SUCCESS' ? 'Success ✅' : 'Failed ❌'}</p>
                    <p><strong>Project:</strong> DevopsSkiStation</p>
                    <p><strong>Branch:</strong> ouday</p>
                    <p><strong>Image:</strong> ${IMAGE_NAME}:${IMAGE_TAG}</p>
                    <p><strong>Logs:</strong> <a href='${env.BUILD_URL}'>View full logs</a></p>
                    <hr>
                    <h3>Stage Summary</h3>
                    <table border='1' style='border-collapse: collapse; width: 100%;'>
                        <tr style='background-color: #f2f2f2;'>
                            <th style='padding: 8px;'>Stage</th>
                            <th style='padding: 8px;'>Duration (s)</th>
                        </tr>
                        ${pipelineReport['stages'].collect { stage, duration ->
                            "<tr><td style='padding: 8px;'>${stage}</td><td style='padding: 8px;'>${duration ?: 'Not executed'}</td></tr>"
                        }.join('\n')}
                    </table>
                    <hr>
                    <h3>Test Results</h3>
                    <p>${pipelineReport['testResults']['summary'] ?: 'No test results available'}</p>
                    <hr>
                    <h3>SonarQube Analysis</h3>
                    <p><a href='${pipelineReport['sonarUrl'] ?: 'http://192.168.33.10:9000'}>View SonarQube Dashboard</a></p>
                    <hr>
                    <h3>Docker Image Scan (Trivy)</h3>
                    <p>${pipelineReport['trivyResults']}</p>
                    <hr>
                    <h3>Docker Compose Status</h3>
                    <pre>${pipelineReport['dockerComposeStatus'] ?: 'No Docker Compose status available'}</pre>
                    <hr>
                    <p><em>Generated by Jenkins on ${new Date()}</em></p>
                </body>
                </html>
                """

                if (currentBuild.result == 'SUCCESS') {
                    sh '''
                        set -e
                        echo "Nettoyage de l'environnement (pipeline réussi)..."
                        if [ -f docker-compose.yml ]; then
                            echo "Contenu de docker-compose.yml avant arrêt :"
                            cat docker-compose.yml
                            echo "Validation de docker-compose.yml..."
                            docker-compose config || echo "Erreur : échec de la validation Docker Compose" >&2
                            echo "Arrêt de Docker Compose..."
                            docker-compose down --volumes --remove-orphans || echo "Erreur : échec de docker-compose down" >&2
                            echo "Suppression du réseau mynetwork..."
                            docker network rm mynetwork || true
                            echo "Vérification des conteneurs restants..."
                            docker ps -a --format '{{.Names}}' || echo "Erreur : échec de docker ps" >&2
                            echo "Vérification des réseaux restants..."
                            docker network ls --format '{{.Name}}' || echo "Erreur : échec de docker network ls" >&2
                            echo "Vérification des volumes restants..."
                            docker volume ls --format '{{.Name}}' || echo "Erreur : échec de docker volume ls" >&2
                        else
                            echo "Aucun fichier docker-compose.yml trouvé, pas de nettoyage Docker Compose nécessaire."
                        fi
                    '''
                    emailext(
                        subject: "Pipeline Report - Build #${env.BUILD_NUMBER} - Success",
                        body: emailBody,
                        to: 'weslatiouday31@gmail.com',
                        mimeType: 'text/html'
                    )
                } else {
                    sh '''
                        echo "Pipeline échoué, préservation des conteneurs pour le débogage..."
                        if [ -f docker-compose.yml ]; then
                            echo "Contenu de docker-compose.yml avant arrêt :"
                            cat docker-compose.yml
                            echo "Validation de docker-compose.yml..."
                            docker-compose config || echo "Erreur : échec de la validation Docker Compose" >&2
                            echo "Arrêt de Docker Compose..."
                            docker-compose down --volumes --remove-orphans || echo "Erreur : échec de docker-compose down" >&2
                            echo "Suppression du réseau mynetwork..."
                            docker network rm mynetwork || true
                            echo "Vérification des conteneurs restants..."
                            docker ps -a --format '{{.Names}}' || echo "Erreur : échec de docker ps" >&2
                            echo "Vérification des réseaux restants..."
                            docker network ls --format '{{.Name}}' || echo "Erreur : échec de docker network ls" >&2
                            echo "Vérification des volumes restants..."
                            docker volume ls --format '{{.Name}}' || echo "Erreur : échec de docker volume ls" >&2
                        else
                            echo "Aucun fichier docker-compose.yml trouvé, pas de nettoyage Docker Compose nécessaire."
                        fi
                    '''
                    emailext(
                        subject: "Pipeline Report - Build #${env.BUILD_NUMBER} - Failed",
                        body: emailBody,
                        to: 'weslatiouday31@gmail.com',
                        mimeType: 'text/html'
                    )
                }
            }
        }
    }
}