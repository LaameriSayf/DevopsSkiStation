pipeline {
    agent any

    environment {
        DB_NAME = 'test_db'
        DB_USER = 'root'
        DB_PASS = ''
        DB_PORT = '3306'
        MYSQL_CONTAINER = 'mysql-test'
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    git branch: 'ouday', url: 'https://github.com/LaameriSayf/DevopsSkiStation.git'
                    def endTime = System.currentTimeMillis()
                    def duration = (endTime - startTime) / 1000 // Durée en secondes
                    env.CHECKOUT_DURATION = "${duration}s"
                }
            }
        }

        stage('Test Docker') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    sh '''
                    set -e
                    echo "Vérification de Docker..."
                    whoami
                    docker version
                    docker ps
                    '''
                    def endTime = System.currentTimeMillis()
                    def duration = (endTime - startTime) / 1000
                    env.TEST_DOCKER_DURATION = "${duration}s"
                }
            }
        }

        stage('Start MySQL') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    sh '''
                    set -e
                    echo "Démarrage de MySQL..."

                    if docker ps -a --format '{{.Names}}' | grep -q "^$MYSQL_CONTAINER$"; then
                        if docker ps --format '{{.Names}}' | grep -q "^$MYSQL_CONTAINER$"; then
                            echo "Le conteneur MySQL est déjà en cours d'exécution."
                        else
                            echo "Le conteneur MySQL existe mais est arrêté. Redémarrage..."
                            docker start $MYSQL_CONTAINER
                        fi
                    else
                        echo "Démarrage d'un nouveau conteneur MySQL..."
                        docker run --name $MYSQL_CONTAINER \
                            -e MYSQL_DATABASE=$DB_NAME \
                            -e MYSQL_ROOT_PASSWORD=$DB_PASS \
                            -p $DB_PORT:3306 \
                            -d mysql:8
                    fi

                    echo "Attente de MySQL (10 sec)..."
                    sleep 10

                    if ! docker ps --format '{{.Names}}' | grep -q "^$MYSQL_CONTAINER$"; then
                        echo "MySQL n'a pas démarré !" 
                        exit 1
                    fi

                    # Vérification de la connexion à MySQL
                    echo "Vérification de la connexion à MySQL..."
                    for i in {1..10}; do
                        if docker exec $MYSQL_CONTAINER mysql -u$DB_USER -p$DB_PASS -e "SELECT 1;" > /dev/null 2>&1; then
                            echo "MySQL est prêt !"
                            break
                        fi
                        echo "MySQL n'est pas encore prêt, attente..."
                        sleep 2
                    done

                    if ! docker exec $MYSQL_CONTAINER mysql -u$DB_USER -p$DB_PASS -e "SELECT 1;" > /dev/null 2>&1; then
                        echo "Échec de la connexion à MySQL après 10 tentatives !"
                        exit 1
                    fi
                    '''
                    def endTime = System.currentTimeMillis()
                    def duration = (endTime - startTime) / 1000
                    env.START_MYSQL_DURATION = "${duration}s"
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    sh 'mvn clean compile'
                    def endTime = System.currentTimeMillis()
                    def duration = (endTime - startTime) / 1000
                    env.BUILD_DURATION = "${duration}s"
                }
            }
        }

        stage('Test with Coverage') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    sh '''
                    echo "Exécution des tests avec couverture..."
                    mvn test
                    '''
                    def endTime = System.currentTimeMillis()
                    def duration = (endTime - startTime) // Durée en millisecondes
                    env.TEST_DURATION = "${duration}ms"
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    withSonarQubeEnv('SQ1') {
                        sh 'mvn sonar:sonar'
                    }
                    def endTime = System.currentTimeMillis()
                    def duration = (endTime - startTime) / 1000
                    env.SONARQUBE_DURATION = "${duration}s"
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    sh '''
                    echo "Déploiement vers Nexus (tests ignorés)..."
                    mvn deploy -DskipTests
                    '''
                    def endTime = System.currentTimeMillis()
                    def duration = (endTime - startTime) / 1000
                    env.NEXUS_DURATION = "${duration}s"
                }
            }
        }

        stage('Generate HTML Report') {
            steps {
                script {
                    // Créer un fichier HTML avec un tableau
                    def htmlContent = """
                    <html>
                    <head>
                        <style>
                            table {
                                width: 100%;
                                border-collapse: collapse;
                            }
                            th, td {
                                border: 1px solid black;
                                padding: 10px;
                                text-align: center;
                            }
                            .duration {
                                background-color: #e6ffe6;
                            }
                        </style>
                    </head>
                    <body>
                        <table>
                            <tr>
                                <th>CHECKOUT</th>
                                <th>TEST DOCKER</th>
                                <th>START MYSQL</th>
                                <th>BUILD</th>
                                <th>TEST</th>
                                <th>SONARQUBE</th>
                                <th>NEXUS</th>
                            </tr>
                            <tr>
                                <td class="duration">${env.CHECKOUT_DURATION ?: 'N/A'}</td>
                                <td class="duration">${env.TEST_DOCKER_DURATION ?: 'N/A'}</td>
                                <td class="duration">${env.START_MYSQL_DURATION ?: 'N/A'}</td>
                                <td class="duration">${env.BUILD_DURATION ?: 'N/A'}</td>
                                <td class="duration">${env.TEST_DURATION ?: 'N/A'}</td>
                                <td class="duration">${env.SONARQUBE_DURATION ?: 'N/A'}</td>
                                <td class="duration">${env.NEXUS_DURATION ?: 'N/A'}</td>
                            </tr>
                        </table>
                    </body>
                    </html>
                    """
                    // Écrire le contenu HTML dans un fichier
                    writeFile file: 'timings.html', text: htmlContent
                }
            }
        }
    }

    post {
        always {
            script {
                echo "Pipeline terminé."
                // Publier le fichier HTML
                publishHTML(target: [
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: '.',
                    reportFiles: 'timings.html',
                    reportName: 'Build Timings Report'
                ])
            }
        }
        failure {
            script {
                echo "Une erreur est survenue."
            }
        }
    }
}
