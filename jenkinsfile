pipeline {
    agent any

    environment {
        DB_NAME = 'test_db'
        DB_USER = 'root'
        DB_PASS = credentials('mysql-password')
        DB_PORT = '3306'
        MYSQL_CONTAINER = 'mysql-test'
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials')
        IMAGE_NAME = 'ouday2025/devopsskistation'
        IMAGE_TAG = 'v29'
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    try {
                        git branch: 'ouday', url: 'https://github.com/LaameriSayf/DevopsSkiStation.git'
                    } finally {
                        def endTime = System.currentTimeMillis()
                        def duration = (endTime - startTime) / 1000
                        echo "Durée de l'étape Checkout : ${duration}s"
                    }
                }
            }
        }

        stage('Test Docker') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    try {
                        sh '''
                        set -e
                        echo "Vérification de Docker..."
                        whoami
                        docker version
                        docker ps
                        '''
                    } finally {
                        def endTime = System.currentTimeMillis()
                        def duration = (endTime - startTime) / 1000
                        echo "Durée de l'étape Test Docker : ${duration}s"
                    }
                }
            }
        }

        stage('Start MySQL') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    try {
                        sh '''
                        set -e
                        echo "Démarrage de MySQL..."

                        if ! docker network ls --format '{{.Name}}' | grep -q "^mynetwork$"; then
                            echo "Création du réseau mynetwork..."
                            docker network create mynetwork
                        fi

                        if docker ps -a --format '{{.Names}}' | grep -q "^$MYSQL_CONTAINER$"; then
                            if docker ps --format '{{.Names}}' | grep -q "^$MYSQL_CONTAINER$"; then
                                echo "Le conteneur MySQL est déjà en cours d'exécution."
                            else
                                echo "Le conteneur MySQL existe mais est arrêté. Redémarrage..."
                                docker start $MYSQL_CONTAINER
                            fi
                        else
                            echo "Démarrage d'un nouveau conteneur MySQL..."
                            docker run --name $MYSQL_CONTAINER \
                                --network mynetwork \
                                -e MYSQL_DATABASE=$DB_NAME \
                                -e MYSQL_ROOT_PASSWORD=$DB_PASS \
                                -p $DB_PORT:3306 \
                                --memory="1g" \
                                --cpus="2" \
                                -d mysql:8.0
                        fi

                        echo "Attente de MySQL (90 sec)..."
                        sleep 90

                        if ! docker ps --format '{{.Names}}' | grep -q "^$MYSQL_CONTAINER$"; then
                            echo "MySQL n'a pas démarré !"
                            echo "Logs du conteneur MySQL :"
                            docker logs $MYSQL_CONTAINER
                            exit 1
                        fi

                        echo "Vérification de la connexion à MySQL..."
                        for i in {1..40}; do
                            echo "Tentative $i : Vérification de l'état du conteneur..."
                            docker ps -a --format '{{.Names}} {{.Status}}' | grep $MYSQL_CONTAINER
                            if docker exec $MYSQL_CONTAINER mysql -u$DB_USER -p$DB_PASS -e "SELECT 1;" > /dev/null 2>&1; then
                                echo "MySQL est prêt !"
                                break
                            fi
                            echo "MySQL n'est pas encore prêt, attente... (tentative $i)"
                            sleep 3
                        done

                        if ! docker exec $MYSQL_CONTAINER mysql -u$DB_USER -p$DB_PASS -e "SELECT 1;" > /dev/null 2>&1; then
                            echo "Échec de la connexion à MySQL après 40 tentatives !"
                            echo "Logs du conteneur MySQL :"
                            docker logs $MYSQL_CONTAINER
                            exit 1
                        fi
                        '''
                    } finally {
                        def endTime = System.currentTimeMillis()
                        def duration = (endTime - startTime) / 1000
                        echo "Durée de l'étape Start MySQL : ${duration}s"
                    }
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    try {
                        sh '''
                        set -e
                        mvn clean compile
                        '''
                    } finally {
                        def endTime = System.currentTimeMillis()
                        def duration = (endTime - startTime) / 1000
                        echo "Durée de l'étape Build : ${duration}s"
                    }
                }
            }
        }

        stage('Test with Coverage') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    try {
                        sh '''
                        set -e
                        echo "Exécution des tests avec couverture..."
                        mvn test
                        '''
                    } finally {
                        def endTime = System.currentTimeMillis()
                        def duration = (endTime - startTime) / 1000
                        echo "Durée de l'étape Test with Coverage : ${duration}s"
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    try {
                        withSonarQubeEnv('SQ1') {
                            sh '''
                            set -e
                            mvn sonar:sonar
                            '''
                        }
                    } finally {
                        def endTime = System.currentTimeMillis()
                        def duration = (endTime - startTime) / 1000
                        echo "Durée de l'étape SonarQube Analysis : ${duration}s"
                    }
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    try {
                        sh '''
                        set -e
                        echo "Déploiement vers Nexus (tests ignorés)..."
                        mvn deploy -DskipTests
                        '''
                    } finally {
                        def endTime = System.currentTimeMillis()
                        def duration = (endTime - startTime) / 1000
                        echo "Durée de l'étape Deploy to Nexus : ${duration}s"
                    }
                }
            }
        }

        stage('Pull Docker Image') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    try {
                        sh '''
                        set -e
                        echo "Connexion à Docker Hub pour tirer l'image..."
                        echo $DOCKERHUB_CREDENTIALS_PSW | docker login -u $DOCKERHUB_CREDENTIALS_USR --password-stdin
                        echo "Téléchargement de l'image Docker ${IMAGE_NAME}:${IMAGE_TAG}..."
                        docker pull ${IMAGE_NAME}:${IMAGE_TAG}
                        '''
                    } finally {
                        def endTime = System.currentTimeMillis()
                        def duration = (endTime - startTime) / 1000
                        echo "Durée de l'étape Pull Docker Image : ${duration}s"
                    }
                }
            }
        }

        stage('Scan Docker Image') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    try {
                        sh '''
                        set -e
                        echo "Scan de l'image avec Trivy..."
                        nice -n 10 trivy image --exit-code 0 --severity HIGH,CRITICAL --scanners vuln --timeout 20m ${IMAGE_NAME}:${IMAGE_TAG}
                        '''
                    } finally {
                        def endTime = System.currentTimeMillis()
                        def duration = (endTime - startTime) / 1000
                        echo "Durée de l'étape Scan Docker Image : ${duration}s"
                    }
                }
            }
        }

        stage('Deploy to Kubernetes with Helm') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    try {
                        echo "Vérification préliminaire pour Kubernetes..."
                        sh '''
                        set -e
                        echo "Vérification des outils..."
                        which kubectl || echo "Erreur : kubectl non trouvé"
                        which helm || echo "Erreur : helm non trouvé"
                        echo "Vérification de la version des outils..."
                        kubectl version --client || echo "Erreur : kubectl non fonctionnel"
                        helm version || echo "Erreur : helm non fonctionnel"
                        '''
                        withKubeConfig([credentialsId: 'kubeconfig-credentials']) {
                            sh '''
                            set -e
                            echo "Vérification de la configuration Kubernetes..."
                            kubectl config view --raw || echo "Erreur : impossible d'afficher la configuration"
                            echo "Test de la connexion au cluster..."
                            kubectl get nodes || echo "Erreur : échec de la connexion au cluster"
                            echo "Vérification des fichiers Helm..."
                            ls -la ./helm/devopsskistation || echo "Erreur : répertoire Helm introuvable"
                            echo "Liste des releases Helm..."
                            helm list --namespace default || echo "Erreur : échec de la commande helm list"
                            echo "Déploiement avec Helm..."
                            helm upgrade --install devopsskistation ./helm/devopsskistation \
                                --set image.tag=${IMAGE_TAG} \
                                --namespace default
                            echo "Vérification du déploiement..."
                            kubectl rollout status deployment/devopsskistation
                            echo "Déploiement Kubernetes terminé !"
                            '''
                        }
                    } catch (Exception e) {
                        echo "Erreur dans Deploy to Kubernetes with Helm : ${e.getMessage()}"
                        throw e
                    } finally {
                        def endTime = System.currentTimeMillis()
                        def duration = (endTime - startTime) / 1000
                        echo "Durée de l'étape Deploy to Kubernetes with Helm : ${duration}s"
                    }
                }
            }
        }

        stage('Docker Compose') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    try {
                        sh '''
                        set -e
                        echo "Vérification de la présence de docker-compose.yml..."
                        if [ -f docker-compose.yml ]; then
                            echo "Fichier docker-compose.yml trouvé."
                            cat docker-compose.yml
                        else
                            echo "Erreur : docker-compose.yml introuvable !"
                            exit 1
                        fi
                        echo "Vérification de l'image Docker..."
                        docker images | grep ${IMAGE_NAME}
                        echo "Vérification et arrêt du conteneur mysql-test..."
                        if docker ps -a --format '{{.Names}}' | grep -q "^mysql-test$"; then
                            echo "Arrêt et suppression du conteneur mysql-test..."
                            docker stop mysql-test || true
                            docker rm mysql-test || true
                        fi
                        echo "Vérification des ports utilisés..."
                        docker ps -a --format '{{.Names}} {{.Ports}}'
                        echo "Exportation de IMAGE_TAG pour Docker Compose..."
                        export IMAGE_TAG=${IMAGE_TAG}
                        echo "Vérification de la valeur de IMAGE_TAG..."
                        echo "IMAGE_TAG=${IMAGE_TAG}"
                        echo "Validation de docker-compose.yml..."
                        docker-compose config || echo "Erreur : échec de la validation Docker Compose"
                        echo "Lancement de Docker Compose avec IMAGE_TAG=${IMAGE_TAG}..."
                        docker-compose up -d
                        echo "Vérification des conteneurs lancés..."
                        docker-compose ps
                        '''
                    } finally {
                        def endTime = System.currentTimeMillis()
                        def duration = (endTime - startTime) / 1000
                        echo "Durée de l'étape Docker Compose : ${duration}s"
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                if (currentBuild.result == 'SUCCESS') {
                    sh '''
                    set -e
                    echo "Nettoyage de l'environnement (pipeline réussi)..."
                    if docker ps --format '{{.Names}}' | grep -q "^$MYSQL_CONTAINER$"; then
                        echo "Arrêt et suppression du conteneur $MYSQL_CONTAINER..."
                        docker stop $MYSQL_CONTAINER || true
                        docker rm $MYSQL_CONTAINER || true
                    fi
                    if [ -f docker-compose.yml ]; then
                        echo "Contenu de docker-compose.yml avant arrêt :"
                        cat docker-compose.yml
                        echo "Validation de docker-compose.yml..."
                        docker-compose config || echo "Erreur : échec de la validation Docker Compose"
                        echo "Arrêt de Docker Compose..."
                        docker-compose down || echo "Erreur : échec de docker-compose down"
                        echo "Vérification des conteneurs restants..."
                        docker ps -a --format '{{.Names}}' || echo "Erreur : échec de docker ps"
                    else
                        echo "Aucun fichier docker-compose.yml trouvé, pas de nettoyage Docker Compose nécessaire."
                    fi
                    '''
                    emailext(
                        subject: "Build #${env.BUILD_NUMBER} - Success",
                        body: """
                        Build #${env.BUILD_NUMBER} succeeded.
                        Details:
                        - Image: ${IMAGE_NAME}:${IMAGE_TAG}
                        - Logs: ${env.BUILD_URL}
                        """,
                        to: 'ouday.oueslati@esprit.tn'
                    )
                } else {
                    sh '''
                    set -e
                    echo "Pipeline échoué, préservation du conteneur $MYSQL_CONTAINER pour le débogage..."
                    if docker ps --format '{{.Names}}' | grep -q "^$MYSQL_CONTAINER$"; then
                        echo "Conteneur $MYSQL_CONTAINER préservé pour débogage."
                    fi
                    if [ -f docker-compose.yml ]; then
                        echo "Contenu de docker-compose.yml avant arrêt :"
                        cat docker-compose.yml
                        echo "Validation de docker-compose.yml..."
                        docker-compose config || echo "Erreur : échec de la validation Docker Compose"
                        echo "Arrêt de Docker Compose..."
                        docker-compose down || echo "Erreur : échec de docker-compose down"
                        echo "Vérification des conteneurs restants..."
                        docker ps -a --format '{{.Names}}' || echo "Erreur : échec de docker ps"
                    else
                        echo "Aucun fichier docker-compose.yml trouvé, pas de nettoyage Docker Compose nécessaire."
                    fi
                    '''
                    emailext(
                        subject: "Build #${env.BUILD_NUMBER} - Failed",
                        body: """
                        Build #${env.BUILD_NUMBER} failed.
                        Details:
                        - Result: ${currentBuild.currentResult}
                        - Logs: ${env.BUILD_URL}
                        """,
                        to: 'ouday.oueslati@esprit.tn'
                    )
                }
            }
        }
    }
}