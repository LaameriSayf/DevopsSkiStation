pipeline {
    agent any

    environment {
        DB_NAME = 'stationski'
        DB_USER = 'root'
        DB_PASS = ''
        DB_PORT = '3306'
        MYSQL_CONTAINER = 'mysql-test'
        IMAGE_NAME = 'halimtrabelsi/gestionstationski-app'
        IMAGE_TAG = '0.0.1'
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    try {
                        git branch: 'Halim', url: 'https://github.com/LaameriSayf/DevopsSkiStation.git'
                    } finally {
                        def endTime = System.currentTimeMillis()
                        echo "Durée de l'étape Checkout : ${(endTime - startTime) / 1000}s"
                    }
                }
            }
        }

        stage('Test Docker') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    try {
                        sh '''
                        echo "Vérification de Docker..."
                        whoami
                        docker version
                        docker ps
                        '''
                    } finally {
                        def endTime = System.currentTimeMillis()
                        echo "Durée de l'étape Test Docker : ${(endTime - startTime) / 1000}s"
                    }
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    try {
                        sh 'mvn clean compile'
                    } finally {
                        def endTime = System.currentTimeMillis()
                        echo "Durée de l'étape Build : ${(endTime - startTime) / 1000}s"
                    }
                }
            }
        }

        stage('Test with Coverage') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    try {
                        sh 'mvn test'
                    } finally {
                        def endTime = System.currentTimeMillis()
                        echo "Durée de l'étape Test with Coverage : ${(endTime - startTime)}ms"
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    try {
                        withSonarQubeEnv('SonarQube') {
                            sh 'mvn sonar:sonar'
                        }
                    } finally {
                        def endTime = System.currentTimeMillis()
                        echo "Durée de l'étape SonarQube Analysis : ${(endTime - startTime) / 1000}s"
                    }
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                script {
                    def startTime = System.currentTimeMillis()
                    try {
                        sh 'mvn deploy -DskipTests'
                    } finally {
                        def endTime = System.currentTimeMillis()
                        echo "Durée de l'étape Deploy to Nexus : ${(endTime - startTime) / 1000}s"
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                echo '🐳 Building Docker Image...'
                sh 'docker build -t $IMAGE_NAME:$IMAGE_TAG .'
            }
        }

        stage('List Docker Images') {
            steps {
                echo '📦 Listing Docker Images...'
                sh 'docker images'
            }
        }

        stage('Push to DockerHub') {
            steps {
                script {
                    echo '🚀 Pushing Docker Image to DockerHub...'
                    withCredentials([usernamePassword(credentialsId: 'dockerhub', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PAT')]) {
                        sh '''
                        echo "$DOCKER_PAT" | docker login -u "$DOCKER_USER" --password-stdin
                        docker push $IMAGE_NAME:$IMAGE_TAG
                        docker logout
                        '''
                    }
                }
            }
        }

        stage('Trivy Scan - DockerHub Image') {
            steps {
                script {
                    def imageName = "$IMAGE_NAME:$IMAGE_TAG"
                    echo "🔍 Scanning Docker Hub image with Trivy: ${imageName}"
                    sh """
                        trivy image --severity CRITICAL --exit-code 0 --no-progress ${imageName} > trivy-report.txt || true
                    """
                    sh 'cat trivy-report.txt'
                }
            }
        }

        stage('Deploy with Docker Compose') {
            steps {
                echo '🚀 Deploying with Docker Compose...'
                sh 'docker compose up -d'
            }
        }
    }

    post {
            always {
                script {
                    def pipelineReport = [:]
                    if (fileExists(env.pipelineReportFile ?: 'pipelineReport.json')) {
                        pipelineReport = readJSON file: env.pipelineReportFile
                    } else {
                        echo "No pipelineReport found, initializing empty report"
                        pipelineReport['stages'] = [:]
                        pipelineReport['testResults'] = [:]
                        pipelineReport['trivyResults'] = 'Not executed'
                        pipelineReport['sonarUrl'] = 'Not executed'
                        pipelineReport['dockerComposeStatus'] = 'Not executed'
                    }

                    def emailBody = """
                    <html>
                    <body style='font-family: Arial, sans-serif; color: #333;'>
                        <h2 style='color: #4CAF50;'>Pipeline Report - Build #${env.BUILD_NUMBER}</h2>
                        <p><strong>Status:</strong> ${currentBuild.result == 'SUCCESS' ? 'Success ✅' : 'Failed ❌'}</p>
                        <p><strong>Project:</strong> DevopsSkiStation</p>
                        <p><strong>Branch:</strong> ${env.GIT_BRANCH}</p>
                        <p><strong>Docker Image:</strong> ${IMAGE_NAME}:${IMAGE_TAG}</p>
                        <p><strong>Logs:</strong> <a href='${env.BUILD_URL}'>View full logs</a></p>
                        <hr>
                        <h3>Stage Summary</h3>
                        <table border='1' style='border-collapse: collapse; width: 100%;'>
                            <tr style='background-color: #f2f2f2;'>
                                <th style='padding: 8px; text-align: left;'>Stage</th>
                                <th style='padding: 8px; text-align: left;'>Duration (s)</th>
                            </tr>
                            ${pipelineReport['stages'].collect { stage, duration ->
                                "<tr><td style='padding: 8px;'>${stage}</td><td style='padding: 8px;'>${duration ?: 'Not executed'}</td></tr>"
                            }.join('\n')}
                        </table>
                        <hr>
                        <h3>Test Results</h3>
                        <p>${pipelineReport['testResults']['summary'] ?: 'No test results available'}</p>
                        <hr>
                        <h3>SonarQube Analysis</h3>
                        <p><a href='${pipelineReport['sonarUrl'] ?: 'http://192.168.33.10:9000'}' style='color: #0073e6;'>View SonarQube Dashboard</a></p>
                        <hr>
                        <h3>Docker Image Scan (Trivy)</h3>
                        <pre>${pipelineReport['trivyResults']}</pre>
                        <hr>
                        <h3>Docker Compose Status</h3>
                        <pre>${pipelineReport['dockerComposeStatus'] ?: 'No Docker Compose status available'}</pre>
                        <hr>
                        <p><em>Generated by Jenkins on ${new Date()}</em></p>
                    </body>
                    </html>
                    """

                    if (currentBuild.result == 'SUCCESS') {
                        emailext(
                            subject: "Pipeline Report - Build #${env.BUILD_NUMBER} - Success",
                            body: emailBody,
                            to: 'weslatiouday31@gmail.com',
                            mimeType: 'text/html'
                        )
                    } else {
                        emailext(
                            subject: "Pipeline Report - Build #${env.BUILD_NUMBER} - Failed",
                            body: emailBody,
                            to: 'weslatiouday31@gmail.com',
                            mimeType: 'text/html'
                        )
                    }
                }
            }
    }
}
